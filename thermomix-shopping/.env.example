# Copy this file to .env and fill in your Cookidoo login.
# .env is gitignored - your credentials never leave your machine.

COOKIDOO_EMAIL=you@example.com
COOKIDOO_PASSWORD=your-cookidoo-password

# UK defaults. Change only if your Cookidoo account is registered elsewhere.
COOKIDOO_COUNTRY=gb
COOKIDOO_LANGUAGE=en-GB
